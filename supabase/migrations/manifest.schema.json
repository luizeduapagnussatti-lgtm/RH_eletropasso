{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Supabase migration manifest",
  "type": "object",
  "required": ["migrations"],
  "properties": {
    "description": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date" },
    "registryTable": { "type": "string", "const": "schema_migrations" },
    "applyScript": { "type": "string" },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "file", "title"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]{4}$" },
          "file": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
